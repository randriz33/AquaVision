{
    "name": "randria33/aquavision-pro",
    "description": "Système de monitoring intelligent pour l'aquaculture",
    "type": "project",
    "keywords": ["aquaculture", "monitoring", "php", "mvc"],
    "license": "MIT",
    "require": {
        "php": ">=7.4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
